# Generate using `python seed_admin.py <password>`
ADMIN_PASSWORD_HASH=scrypt:32768:8:1$bON8eE4lblo75tAA$954096c8cdbdd93de5045d4f467354a4678222dc5c4bc7e94bd4d0d3c163bf638363413c86b7e8acfc023105ff23199e180daa093a2c9b06f600e5a8cdafd8be

